# 服务器配置
NODE_ENV=production
PORT=3001

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lottery_platform
DB_USER=root
DB_PASSWORD=your_password_here

# JWT 配置
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# 域名配置（用于 CORS）
FRONTEND_URL=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# 广告配置
AD_ENABLED=true
DEFAULT_AD_POINTS=10

# 积分配置
SIGNIN_POINTS=20
AD_VIEW_POINTS=10
DEFAULT_PLAN_POINTS=50
